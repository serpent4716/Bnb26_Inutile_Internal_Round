MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/creatorai
GEMINI_API_KEY=
# GEMINI_TEXT_MODEL=gemini-3.5-flash
# GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-flash-lite-latest
GROQ_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
STORAGE_BACKEND=local        # local | cloudinary
PEXELS_API_KEY=              # optional
WHISPER_LOCAL_MODEL=base     # faster-whisper fallback: tiny | base | small | medium
JWT_SECRET=                  # python -c "import secrets; print(secrets.token_hex(32))"
CORS_ORIGINS=http://localhost:5173
ENABLE_DEV_ENDPOINTS=true

# ---------------------------------------------------------------- Trend-to-Short (app/trendshort)
# Reuses GEMINI_API_KEY / GEMINI_TEXT_MODEL / GROQ_API_KEY / PEXELS_API_KEY / WHISPER_LOCAL_MODEL from above.
T2S_MOCK_MODE=false          # true = whole pipeline runs offline on demo_assets, no API keys needed
# LLM fallback chain for trend ideas + scripts. GEMINI_MODEL overrides GEMINI_TEXT_MODEL for this feature only.
LLM_ORDER=gemini,groq,openrouter,ollama
GROQ_MODEL=                  # e.g. a current Groq chat model id; blank = Groq skipped
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# Trends: YouTube Data API v3 key (console.cloud.google.com -> enable "YouTube Data API v3" -> API key)
YOUTUBE_API_KEY=
TREND_SOURCES=youtube        # comma-separated: youtube, google_trends, reddit
TREND_ALL_REGIONS=US,IN,GB
TREND_CACHE_MINUTES=30
# Voice: edge-tts needs no key. Order is the fallback chain.
TTS_ORDER=edge,piper,kokoro
EDGE_TTS_VOICE=en-US-AndrewNeural
# Footage: Pexels (above) then Pixabay
PIXABAY_API_KEY=
MUSIC_PATH=                  # optional licensed background track
# Folder with ffmpeg + ffprobe, only if they are not on PATH (winget installs are auto-detected)
FFMPEG_DIR=
# Real YouTube upload (optional; dry run works without it). OAuth "Desktop app" client JSON path.
YOUTUBE_CLIENT_SECRETS=
